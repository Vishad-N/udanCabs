# Environment Variables Example

# Backend
PORT=3000
DATABASE_URL="postgresql://postgres:password@localhost:5432/udan_cabs?schema=public"

# Authentication Secrets
JWT_SECRET="generate_a_very_secure_random_string_here_for_production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="generate_a_very_secure_random_string_here_for_production"

# Default Super Admin Credentials (used during initial database seed)
ADMIN_EMAIL="admin@udancabs.com"
ADMIN_PASSWORD="secure_admin_password_here"

# Meta WhatsApp Business API
WHATSAPP_TOKEN="your_meta_whatsapp_api_bearer_token"
WHATSAPP_PHONE_ID="your_phone_id"
WHATSAPP_BUSINESS_PHONE="your_business_phone_number_with_country_code"

# Google Maps Platform (For Pricing/Distance Calculation)
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Client Frontend
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Admin Frontend
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
